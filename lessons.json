            "bent": "Dedos doblados",
            "pointed": "Dedo(s) extendido(s)"
        },
        "movements": {
            "none": "Sin movimiento",
            "shake": "Agitar",
            "rotate": "Rotar",
            "wave": "Ondular",
            "tap": "Tocar"
        }
    }
