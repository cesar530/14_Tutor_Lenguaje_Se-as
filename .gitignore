models/*.pkl
models/*.h5
models/*.keras
!models/.gitkeep

data/landmarks/*.npy
data/landmarks/*.csv
!data/.gitkeep
!data/landmarks/.gitkeep

# Large files
*.mp4
*.avi
*.mov
*.zip
*.tar.gz

